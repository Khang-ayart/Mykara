<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:label="Mykara"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name="com.mykara.project.ProjectActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.mykara.project.SupportActivity"
            android:exported="false"
            android:label="Mykara – ủng hộ" />
        <activity
            android:name="com.mykara.project.SyncActivity"
            android:exported="false"
            android:label="Mykara – đồng bộ lời" />
        <activity
            android:name="com.mykara.project.PreviewActivity"
            android:exported="false"
            android:label="Mykara – xem trước" />
        <activity
            android:name="com.mykara.prototype.MainActivity"
            android:exported="false"
            android:label="Mykara – dựng thử" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
