{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mykara.local/schema/scene.schema.json",
  "title": "Mykara Scene JSON",
  "description": "Mô tả đầy đủ video, sinh ra từ project.json. Preview và Export dùng chung. Không chứa thông tin origin/confidence.",
  "type": "object",
  "required": [
    "version",
    "width",
    "height",
    "fps",
    "durationMs",
    "audio",
    "layers"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "fps": {
      "type": "integer",
      "minimum": 1
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "audio": {
      "type": "object",
      "required": [
        "file"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        }
      }
    },
    "layers": {
      "type": "array",
      "description": "Vẽ theo thứ tự từ dưới lên trên.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "fromMs",
          "toMs"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "image",
              "text",
              "reactive",
              "particles",
              "overlay",
              "semantic"
            ]
          },
          "fromMs": {
            "type": "integer",
            "minimum": 0
          },
          "toMs": {
            "type": "integer",
            "minimum": 0
          },
          "source": {
            "type": "string",
            "description": "image: đường dẫn ảnh. reactive: tên visualizer."
          },
          "text": {
            "type": "string"
          },
          "style": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "fontSize": {
                "type": "number"
              },
              "font": {
                "type": "string"
              },
              "color": {
                "type": "string"
              }
            }
          },
          "animations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "phase",
                "effect"
              ],
              "additionalProperties": false,
              "properties": {
                "phase": {
                  "enum": [
                    "enter",
                    "hold",
                    "exit"
                  ]
                },
                "effect": {
                  "type": "string"
                },
                "durationMs": {
                  "type": "integer",
                  "minimum": 0
                },
                "params": {
                  "type": "object"
                }
              }
            }
          },
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "text",
                "startMs",
                "endMs"
              ],
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string"
                },
                "startMs": {
                  "type": "integer",
                  "minimum": 0
                },
                "endMs": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "params": {
            "type": "object"
          },
          "hideText": {
            "type": "array",
            "description": "Chỉ số từ (words) cần ẩn vì đã có hình thay.",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "items": {
            "type": "array",
            "description": "Chỉ cho layer type semantic. Thời gian đã quy ra ms tuyệt đối.",
            "items": {
              "type": "object",
              "required": [
                "id",
                "fromMs",
                "toMs",
                "visual",
                "phases",
                "seed"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "fromMs": {
                  "type": "integer",
                  "minimum": 0
                },
                "toMs": {
                  "type": "integer",
                  "minimum": 0
                },
                "visual": {
                  "type": "object",
                  "required": [
                    "kind",
                    "ref"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "emoji",
                        "vector",
                        "userImage"
                      ]
                    },
                    "ref": {
                      "type": "string"
                    }
                  }
                },
                "style": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "size": {
                      "type": "number"
                    }
                  }
                },
                "phases": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "atMs",
                      "preset"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "atMs": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "preset": {
                        "type": "string"
                      },
                      "durationMs": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "params": {
                        "type": "object"
                      }
                    }
                  }
                },
                "seed": {
                  "type": "integer",
                  "description": "Giữ kết quả ngẫu nhiên (hạt, mảnh vỡ) giống nhau giữa preview và export."
                }
              }
            }
          }
        }
      }
    },
    "analysis": {
      "type": "object",
      "description": "Dữ liệu phân tích âm thanh cho hiệu ứng phản ứng theo nhạc.",
      "additionalProperties": false,
      "properties": {
        "beatsMs": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "bassEnvelope": {
          "type": "object",
          "required": [
            "hz",
            "values"
          ],
          "additionalProperties": false,
          "properties": {
            "hz": {
              "type": "integer",
              "minimum": 1
            },
            "values": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    }
  }
}
