{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mykara.local/schema/scene.schema.json",
  "title": "Mykara Scene JSON",
  "description": "Mô tả đầy đủ video, sinh ra từ project.json bởi SceneBuilder. Preview và Export dùng chung. Không chứa origin/confidence.",
  "type": "object",
  "required": [
    "version",
    "width",
    "height",
    "fps",
    "durationMs",
    "audio",
    "layers"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "fps": {
      "type": "integer",
      "minimum": 1
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "template": {
      "type": "string"
    },
    "audio": {
      "type": "object",
      "required": [
        "file"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        }
      }
    },
    "layers": {
      "type": "array",
      "description": "Vẽ từ dưới lên trên.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "fromMs",
          "toMs"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "image",
              "text",
              "reactive",
              "particles",
              "overlay",
              "semantic",
              "title"
            ]
          },
          "fromMs": {
            "type": "integer",
            "minimum": 0
          },
          "toMs": {
            "type": "integer",
            "minimum": 0
          },
          "source": {
            "type": "string",
            "description": "image: URL ảnh. overlay/particles/reactive: tên loại."
          },
          "text": {
            "type": "string"
          },
          "style": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "fontSize": {
                "type": "number"
              },
              "font": {
                "type": "string"
              },
              "weight": {
                "type": "string"
              },
              "color": {
                "type": "string"
              },
              "highlightColor": {
                "type": "string"
              },
              "strokeColor": {
                "type": "string"
              },
              "emphasisColor": {
                "type": "string"
              },
              "plain": {
                "type": "boolean"
              },
              "shadowColor": {
                "type": "string"
              },
              "maxWidth": {
                "type": "number"
              },
              "lineHeight": {
                "type": "number"
              }
            }
          },
          "animations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "phase",
                "effect"
              ],
              "additionalProperties": false,
              "properties": {
                "phase": {
                  "enum": [
                    "enter",
                    "hold",
                    "exit"
                  ]
                },
                "effect": {
                  "type": "string"
                },
                "durationMs": {
                  "type": "integer",
                  "minimum": 0
                },
                "params": {
                  "type": "object"
                }
              }
            }
          },
          "title": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "credits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "text",
                "startMs",
                "endMs"
              ],
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string"
                },
                "startMs": {
                  "type": "integer",
                  "minimum": 0
                },
                "endMs": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "hideText": {
            "type": "array",
            "description": "Chỉ số từ bị ẩn vì đã có hình thay (vẫn giữ chỗ trong câu).",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "params": {
            "type": "object"
          },
          "items": {
            "type": "array",
            "description": "Chỉ cho layer type semantic.",
            "items": {
              "type": "object",
              "required": [
                "id",
                "fromMs",
                "toMs",
                "visual",
                "phases",
                "seed",
                "anchor"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "fromMs": {
                  "type": "integer",
                  "minimum": 0
                },
                "toMs": {
                  "type": "integer",
                  "minimum": 0
                },
                "visual": {
                  "type": "object",
                  "required": [
                    "kind",
                    "ref"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "emoji",
                        "vector",
                        "userImage",
                        "frame"
                      ]
                    },
                    "ref": {
                      "type": "string"
                    },
                    "variant": {
                      "enum": [
                        "film",
                        "polaroid",
                        "viewfinder"
                      ]
                    }
                  }
                },
                "style": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "size": {
                      "type": "number"
                    }
                  }
                },
                "phases": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "atMs",
                      "preset"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "atMs": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "preset": {
                        "type": "string"
                      },
                      "durationMs": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "params": {
                        "type": "object"
                      }
                    }
                  }
                },
                "seed": {
                  "type": "integer"
                },
                "anchor": {
                  "type": "object",
                  "required": [
                    "mode"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "mode": {
                      "enum": [
                        "hero",
                        "inline",
                        "above"
                      ]
                    },
                    "layer": {
                      "type": "string"
                    },
                    "tokenStart": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "tokenEnd": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "beatsMs": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "bpm": {
          "type": "number"
        },
        "bassEnvelope": {
          "type": "object",
          "required": [
            "hz",
            "values"
          ],
          "additionalProperties": false,
          "properties": {
            "hz": {
              "type": "integer",
              "minimum": 1
            },
            "values": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    }
  }
}
